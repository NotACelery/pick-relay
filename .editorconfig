root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{gradle,toml}]
indent_style = space
indent_size = 4

[*.{json,mcmeta}]
indent_style = space
indent_size = 2

[*.{md,yml,yaml}]
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf

[*.bat]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf
